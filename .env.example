# LLM Configuration
OPENAI_API_KEY=your-api-key-here
# 支持 OpenAI Chat Completions 兼容接口；请按自己的模型服务商修改。
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen-max

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-v1

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/tasks.db

# App
APP_ENV=development
LOG_LEVEL=INFO
MAX_REFLOW_COUNT=2

# 发布版建议默认关闭实验性能力；需要时可由买家自行开启。
MEMORY_ENABLED=false
DIALOGUE_ENABLED=false
PLAN_VARIANTS_ENABLED=false
REPAIRER_ENABLED=true
SELF_REFINE_ENABLED=true

# 性能相关
# 输入清洗默认走规则（0 次模型调用）；需要语义改写时置 true。
INPUT_NORMALIZE_LLM_ENABLED=false
INPUT_NORMALIZE_MAX_CHARS=8000
# 并行执行的任务数。每个任务一次完整工作流，数值过高可能触发供应商限流。
TASK_WORKER_CONCURRENCY=2
# 结构化输出续写时，第 2 轮起只回传已生成内容的尾部，减少重复 token。
CONTINUATION_SLIM_CONTEXT_ENABLED=true

# 图片需求识别（上传截图 / 多模态提取）
# 本地 OCR 默认就绪，无需额外密钥；视觉模型未配置时自动只走 OCR。
IMAGE_EXTRACT_ENABLED=true
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=40000000
IMAGE_TARGET_LONG_EDGE=2000
VISION_TIMEOUT_SECONDS=60
OCR_TIMEOUT_SECONDS=30
OCR_MAX_CONCURRENCY=2
VISION_FALLBACK_OCR_ENABLED=true

# 视觉模型（可选，配置后优先于本地 OCR）。也可在「模型配置 → 图片识别（多模态）」页面填写。
# ROLE_VISION_MODEL=qwen-vl-max
# ROLE_VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# ROLE_VISION_API_KEY=sk-...
# ROLE_VISION_MAX_TOKENS=2048

# 计价：DeepSeek 分时段计费，价目表填高峰价，空闲时段按该系数折算（官方为半价）。
OFF_PEAK_PRICE_RATIO=0.5
# 判断高峰时段所用时区偏移（北京时间 = 8）
PEAK_TIMEZONE_OFFSET=8
USD_TO_CNY_RATE=7.1
