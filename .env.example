# LLM Configuration
OPENAI_API_KEY=your-api-key-here
# 支持 OpenAI Chat Completions 兼容接口；请按自己的模型服务商修改。
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen-max

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-v1

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/tasks.db

# App
APP_ENV=development
LOG_LEVEL=INFO
MAX_REFLOW_COUNT=2

# 发布版建议默认关闭实验性能力；需要时可由买家自行开启。
MEMORY_ENABLED=false
DIALOGUE_ENABLED=false
PLAN_VARIANTS_ENABLED=false
REPAIRER_ENABLED=true
SELF_REFINE_ENABLED=true

# DingTalk Robot Service Settings
DINGTALK_SERVICE_ENABLED=false
DINGTALK_APP_KEY=your-dingtalk-appkey
DINGTALK_APP_SECRET=your-dingtalk-appsecret
# 可选：轮询间隔（秒），默认 3
# DINGTALK_NOTIFY_INTERVAL_SECONDS=3