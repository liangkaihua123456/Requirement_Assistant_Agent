# LLM Configuration
OPENAI_API_KEY=your-api-key-here
# 支持 OpenAI Chat Completions 兼容接口；请按自己的模型服务商修改。
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen-max

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-v1

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/tasks.db

# App
APP_ENV=development
LOG_LEVEL=INFO
MAX_REFLOW_COUNT=2

# 发布版建议默认关闭实验性能力；需要时可由买家自行开启。
MEMORY_ENABLED=false
DIALOGUE_ENABLED=false
PLAN_VARIANTS_ENABLED=false
REPAIRER_ENABLED=true
SELF_REFINE_ENABLED=true

# DingTalk dual-robot settings
DINGTALK_SERVICE_ENABLED=false
# 可选：轮询间隔（秒），默认 3
# DINGTALK_NOTIFY_INTERVAL_SECONDS=3

# 机器人1：提出澄清/评审问题（OpenAPI 主动发群消息）
DINGTALK_ROBOT1_APP_ID=
DINGTALK_ROBOT1_APP_KEY=
DINGTALK_ROBOT1_APP_SECRET=
# 可选；默认等于 APP_KEY
# DINGTALK_ROBOT1_CODE=

# 机器人2：收消息、建任务、自动补充/纠错建议（Stream）
DINGTALK_ROBOT2_APP_ID=
DINGTALK_ROBOT2_APP_KEY=your-dingtalk-appkey
DINGTALK_ROBOT2_APP_SECRET=your-dingtalk-appsecret
# 兼容旧变量（未设置 ROBOT2 时回退到这里）
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=

# 机器人2 建议能力：仍需人工确认后才提交
DINGTALK_ASSIST_ENABLED=true
# 人工直接回复澄清时，是否先纠错再请确认
DINGTALK_ASSIST_CORRECT_REPLY=true
# PDF 正文最大注入字符；优先读群文件，其次可选 arXiv
DINGTALK_DOC_MAX_CHARS=40000
DINGTALK_GROUP_FILE_ENABLED=true
DINGTALK_DOC_ARXIV_FALLBACK=true
# 可选：固定操作者 unionId（默认用提问人 senderStaffId 换取）
# DINGTALK_OPERATOR_UNION_ID=
